{
  "name": "serms-modern",
  "private": true,
  "version": "0.1.0",
  "description": "SERMS Modern — a cleaner front end for St. Peter's College student records",
  "author": "St. Peter's College",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:smoke": "node tests/run-smoke.mjs",
    "electron:dev": "concurrently -k \"vite --port 5173\" \"wait-on http://127.0.0.1:5173 && node scripts/electron-dev.cjs\"",
    "electron:build": "npm run build && electron-builder --win portable --x64",
    "electron:installer": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "pg-protocol": "^1.16.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^45.3.1",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "ph.edu.spc.serms",
    "productName": "SERMS Modern",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "config/srgb.ini",
        "to": "srgb.ini"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SERMS Modern"
    }
  }
}
